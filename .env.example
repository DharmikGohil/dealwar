# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://dealwar:dealwar@localhost:5434/dealwar?schema=public

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Used to hash network identifiers and encrypt coupon inventory.
ABUSE_HASH_SECRET=replace-with-a-separate-32-byte-secret
COUPON_ENCRYPTION_KEY=replace-with-64-hex-characters

# Optional social auth. Email/password remains available without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=DealWar <hello@example.com>
SUPPORT_EMAIL=hello@example.com

# Dodo Payments. Start in test_mode; switch only after live verification and test drills.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_BUSINESS_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
PAYMENTS_ENABLED=false
DEAL_ENTRY_FEE_CENTS=1900

# S3-compatible storage for moderated company logos (AWS S3, Cloudflare R2, etc.)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# Operations
ADMIN_EMAILS=
CRON_SECRET=replace-with-a-random-cron-secret
